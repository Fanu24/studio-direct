{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gaming-crawler",
  "account_id": "ff222c50c538a09ccd8d08f7d47e82e8",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 */6 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gaming-jobs",
      "database_id": "83a17a11-c365-4d1b-a52e-86fb44817f3c",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "LOCKS",
      "id": "19e0b11e2bc8449a97b121bb740e7d2c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "gaming-jobs-files"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "SOURCE_DISCOVERY_ENABLED": "true",
    "EMAIL_FROM": "noreply@studio-direct.example",
    "EMAIL_ENABLED": "false",
    "ADMIN_EMAILS": "",
    "SITE_URL": "http://localhost:3000"
  },
  "queues": {
    "producers": [
      {
        "binding": "CRAWL_CAREER",
        "queue": "crawl-career"
      },
      {
        "binding": "CRAWL_LINKEDIN",
        "queue": "crawl-linkedin"
      },
      {
        "binding": "CRAWL_INDEED",
        "queue": "crawl-indeed"
      }
    ],
    "consumers": [
      {
        "queue": "crawl-career",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 10,
        "retry_delay": 60,
        "dead_letter_queue": "crawl-career-failed"
      },
      {
        "queue": "crawl-linkedin",
        "max_batch_size": 1
      },
      {
        "queue": "crawl-indeed",
        "max_batch_size": 1
      }
    ]
  }
}
