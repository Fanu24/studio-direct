{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gaming-web",
  "account_id": "ff222c50c538a09ccd8d08f7d47e82e8",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gaming-jobs",
      "database_id": "83a17a11-c365-4d1b-a52e-86fb44817f3c",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "gaming-jobs-files"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "",
    "EMAIL_FROM": "noreply@studio-direct.example",
    "STRIPE_ENABLED": "false",
    "SITE_URL": "http://localhost:3000",
    "EMAIL_ENABLED": "false",
    "ADMIN_EMAILS": ""
  }
}
