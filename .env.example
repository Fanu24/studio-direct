# Future deployment only. Local development uses pnpm setup:local and .dev.vars.
# Fill in the GitHub production environment when ready to connect online.
SITE_URL=https://your-domain.example
# Keep false while design and product changes are still being reviewed.
SITE_INDEXING_ENABLED=false
ADMIN_EMAILS=
EMAIL_ENABLED=true
EMAIL_FROM=
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
