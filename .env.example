# Future deployment only. Local development uses pnpm setup:local and .dev.vars.
# Fill in the GitHub production environment when ready to connect online.
SITE_URL=https://your-domain.example
# Allow all crawlers on public pages. Set false only to disable indexing explicitly.
SITE_INDEXING_ENABLED=true
ADMIN_EMAILS=
EMAIL_ENABLED=true
EMAIL_FROM=
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
D1_DATABASE_NAME=nodework-jobs
LOCKS_KV_ID=
R2_BUCKET_NAME=nodework-files
WEB_WORKER_NAME=nodework-web
CRAWLER_WORKER_NAME=nodework-crawler
QUEUE_PREFIX=nodework-crawl
TURNSTILE_SITE_KEY=
STRIPE_ENABLED=false
# Secrets: use GitHub environment secrets; never commit populated values.
CLOUDFLARE_API_TOKEN=
BETTER_AUTH_SECRET=
TURNSTILE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEB3_CAREER_API_TOKEN=

# Product operations: use the same random 32+ character secret on both Workers.
PRODUCT_INTERNAL_SECRET=
# Keep outbound marketing off until accounts, consent and publication settings are ready.
SOCIAL_DELIVERY_ENABLED=false
NEWSLETTER_DELIVERY_ENABLED=false
X_USER_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Product feature flags live in D1 and are managed in /admin/product.
# Stripe remains sandbox: sk_test_... only for the new product offers.
